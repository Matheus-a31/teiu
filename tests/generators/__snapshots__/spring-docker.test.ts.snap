// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Generator: Spring Dockerfile & .dockerignore > should generate multi-stage Dockerfile for 'spring-gradle' 1`] = `
"# ==============================================================================
# 🦎 Dockerfile gerado pelo Teiú — Toolkit de Entrega, Infraestrutura e Unificação
# Stack: Spring Boot | Multi-stage build | Non-root security | Otimizado para cache
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Resolução de Dependências
# ------------------------------------------------------------------------------
FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /build

# Cache de dependências do Gradle
COPY gradlew ./
COPY gradle ./gradle
COPY build.gradle settings.gradle* ./
RUN chmod +x ./gradlew && ./gradlew dependencies --no-daemon || true

# Copia código-fonte e empacota o jar executável
COPY src ./src
RUN ./gradlew bootJar -x test --no-daemon

# ------------------------------------------------------------------------------
# Stage 2: Runtime enxuto, seguro e sem ferramentas de build
# ------------------------------------------------------------------------------
FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app

# Criação de grupo e usuário sem privilégios de root para mitigar riscos de segurança
RUN addgroup -S app && adduser -S app -G app

# Copia o artefato compilado concedendo permissões ao usuário app
COPY --from=builder --chown=app:app /build/build/libs/*.jar app.jar

# Define o usuário de execução da aplicação
USER app

# Expõe a porta de escuta da aplicação
EXPOSE 9090

# Verificação de saúde em runtime
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \\
  CMD wget -qO- http://localhost:9090/actuator/health || exit 1

# Inicialização com suporte a limites de memória do container
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
"
`;

exports[`Generator: Spring Dockerfile & .dockerignore > should generate multi-stage Dockerfile for 'spring-kotlin' 1`] = `
"# ==============================================================================
# 🦎 Dockerfile gerado pelo Teiú — Toolkit de Entrega, Infraestrutura e Unificação
# Stack: Spring Boot | Multi-stage build | Non-root security | Otimizado para cache
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Resolução de Dependências
# ------------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build

# Cache de dependências do Gradle
COPY gradlew ./
COPY gradle ./gradle
COPY build.gradle.kts settings.gradle.kts* ./
RUN chmod +x ./gradlew && ./gradlew dependencies --no-daemon || true

# Copia código-fonte e empacota o jar executável
COPY src ./src
RUN ./gradlew bootJar -x test --no-daemon

# ------------------------------------------------------------------------------
# Stage 2: Runtime enxuto, seguro e sem ferramentas de build
# ------------------------------------------------------------------------------
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app

# Criação de grupo e usuário sem privilégios de root para mitigar riscos de segurança
RUN addgroup -S app && adduser -S app -G app

# Copia o artefato compilado concedendo permissões ao usuário app
COPY --from=builder --chown=app:app /build/build/libs/*.jar app.jar

# Define o usuário de execução da aplicação
USER app

# Expõe a porta de escuta da aplicação
EXPOSE 8081

# Verificação de saúde em runtime
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \\
  CMD wget -qO- http://localhost:8081/actuator/health || exit 1

# Inicialização com suporte a limites de memória do container
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
"
`;

exports[`Generator: Spring Dockerfile & .dockerignore > should generate multi-stage Dockerfile for 'spring-maven' 1`] = `
"# ==============================================================================
# 🦎 Dockerfile gerado pelo Teiú — Toolkit de Entrega, Infraestrutura e Unificação
# Stack: Spring Boot | Multi-stage build | Non-root security | Otimizado para cache
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Resolução de Dependências
# ------------------------------------------------------------------------------
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /build

# Cache de dependências do Maven
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x ./mvnw && ./mvnw dependency:go-offline -B

# Copia código-fonte e empacota o artefato sem rodar testes (já validados no CI)
COPY src ./src
RUN ./mvnw clean package -DskipTests -B


# ------------------------------------------------------------------------------
# Stage 2: Runtime enxuto, seguro e sem ferramentas de build
# ------------------------------------------------------------------------------
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app

# Criação de grupo e usuário sem privilégios de root para mitigar riscos de segurança
RUN addgroup -S app && adduser -S app -G app

# Copia o artefato compilado concedendo permissões ao usuário app
COPY --from=builder --chown=app:app /build/target/*.jar app.jar

# Define o usuário de execução da aplicação
USER app

# Expõe a porta de escuta da aplicação
EXPOSE 8080

# Verificação de saúde em runtime
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \\
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

# Inicialização com suporte a limites de memória do container
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
"
`;
