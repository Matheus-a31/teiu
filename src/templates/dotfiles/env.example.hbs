# ==============================================================================
# 🦎 .env.example gerado pelo Teiú
# Copie este arquivo para .env e customize as variáveis conforme seu ambiente
# ==============================================================================

# Aplicação
PORT={{port}}
{{#if (eq stack "spring")}}
SPRING_PROFILES_ACTIVE=prod
{{else}}
NODE_ENV=production
{{/if}}

{{#if (eq db "postgres")}}
# Banco de Dados (PostgreSQL)
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:secret@localhost:5432/appdb
{{else if (eq db "mysql")}}
# Banco de Dados (MySQL)
MYSQL_DATABASE=appdb
MYSQL_USER=app
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_PORT=3306
DATABASE_URL=mysql://app:secret@localhost:3306/appdb
{{/if}}

{{#if (eq cache "redis")}}
# Cache / Fila (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
{{/if}}
