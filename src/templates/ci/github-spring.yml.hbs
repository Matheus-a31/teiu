# ==============================================================================
# 🦎 Pipeline de CI/CD gerado pelo Teiú — Toolkit de Entrega, Infraestrutura e Unificação
# Stack: Spring Boot | GitHub Actions | Cache GHA | Multi-stage Docker Build
# ==============================================================================

name: CI / CD

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master

permissions:
  contents: read
{{#if isGhcr}}
  packages: write
{{/if}}

jobs:
  # ----------------------------------------------------------------------------
  # Job 1: Testes automatizados e verificação de integridade
  # ----------------------------------------------------------------------------
  test:
    name: Test & Verify
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK {{javaVersion}}
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '{{javaVersion}}'
          cache: '{{cacheType}}'

{{#if isMaven}}
      - name: Run Maven verify
        run: |
{{#if hasWrapper}}
          chmod +x ./mvnw
          ./mvnw clean verify
{{else}}
          mvn clean verify
{{/if}}
{{/if}}
{{#if isGradle}}
      - name: Run Gradle check
        run: |
{{#if hasWrapper}}
          chmod +x ./gradlew
          ./gradlew check
{{else}}
          gradle check
{{/if}}
{{/if}}

  # ----------------------------------------------------------------------------
  # Job 2: Build da imagem Docker e Push para o Container Registry
  # ----------------------------------------------------------------------------
  build-and-push:
    name: Build & Push Docker Image
    needs: test
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

{{#if isGhcr}}
      - name: Log in to GitHub Container Registry (GHCR)
        if: {{gh "github.event_name != 'pull_request'"}}
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: {{gh "github.actor"}}
          password: {{gh "secrets.GITHUB_TOKEN"}}
{{/if}}
{{#if isDockerHub}}
      - name: Log in to Docker Hub
        if: {{gh "github.event_name != 'pull_request'"}}
        uses: docker/login-action@v3
        with:
          username: {{gh "secrets.DOCKER_HUB_USERNAME"}}
          password: {{gh "secrets.DOCKER_HUB_TOKEN"}}
{{/if}}
{{#if isEcr}}
      - name: Configure AWS credentials
        if: {{gh "github.event_name != 'pull_request'"}}
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: {{gh "secrets.AWS_ACCESS_KEY_ID"}}
          aws-secret-access-key: {{gh "secrets.AWS_SECRET_ACCESS_KEY"}}
          aws-region: {{gh "secrets.AWS_REGION"}}

      - name: Log in to Amazon ECR
        if: {{gh "github.event_name != 'pull_request'"}}
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2
{{/if}}

      - name: Extract Docker metadata (Tags & Labels)
        id: meta
        uses: docker/metadata-action@v5
        with:
{{#if isGhcr}}
          images: ghcr.io/{{gh "github.repository"}}
{{/if}}
{{#if isDockerHub}}
          images: {{gh "secrets.DOCKER_HUB_USERNAME"}}/{{gh "github.event.repository.name"}}
{{/if}}
{{#if isEcr}}
          images: {{gh "steps.login-ecr.outputs.registry"}}/{{gh "github.event.repository.name"}}
{{/if}}
          tags: |
            type=sha,format=long
            type=raw,value=latest,enable={{gh "github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master'"}}

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: {{gh "github.event_name != 'pull_request'"}}
          tags: {{gh "steps.meta.outputs.tags"}}
          labels: {{gh "steps.meta.outputs.labels"}}
          cache-from: type=gha
          cache-to: type=gha,mode=max
