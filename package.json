{
  "name": "teiu",
  "version": "0.1.0",
  "description": "Infra pronta, do jeito certo. CLI para geração de Dockerfile, compose e CI/CD.",
  "type": "module",
  "bin": {
    "teiu": "./bin/teiu.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "cli",
    "docker",
    "docker-compose",
    "ci-cd",
    "github-actions",
    "spring-boot",
    "nestjs",
    "infrastructure",
    "devops"
  ],
  "author": "Matheus",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.11.2",
    "handlebars": "^4.7.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
